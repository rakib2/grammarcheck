# ── Supabase ─────────────────────────────────────────────────
# Get these from https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase (service role) — used by server routes that need to
# bypass RLS (e.g. usage enforcement). Found in Project → Settings → API →
# "service_role" key. NEVER expose this client-side.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI providers ────────────────────────────────────────────
# Anthropic (Claude) — grammar analysis in /api/converse and friends.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — Realtime voice, TTS, transcription.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Demo / access control ───────────────────────────────────
# Invite code required for new signups. Anyone with the live URL and this
# code can create an account. Change to something unguessable before demo.
# Leave empty to disable gating (open signup — NOT recommended for demo).
SIGNUP_INVITE_CODE=
